# ── Application ──
APP_NAME=AtomCV
APP_BASE_URL=http://localhost:3000

# ── Database ──
POSTGRES_DB=atomcv
POSTGRES_USER=atomcv
POSTGRES_PASSWORD=change_me

# ── LLM (filled in at Stage 2) ──
# Whatever model you name here needs a row in atomcv.llm.pricing, or every
# call it makes is costed at zero (F-015). The backend warns at startup when
# it does not.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_CHAIN_CHEAP=
LLM_CHAIN_MID=

# ── Security (filled in at Stage 3) ──
SESSION_SECRET=
TURNSTILE_SECRET_KEY=

# ── Services (filled in at Stage 3) ──
RESEND_API_KEY=
AXIOM_TOKEN=
SENTRY_DSN=

# ── Budget ──
DAILY_BUDGET_USD=40
