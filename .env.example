# ── Application ──
# No APP_NAME: nothing in this repository read it. The frontend has its own
# .env and is welcome to one; a name here was a knob wired to nothing.
APP_BASE_URL=http://localhost:3000

# ── Database ──
POSTGRES_DB=atomcv
POSTGRES_USER=atomcv
POSTGRES_PASSWORD=change_me

# ── LLM (filled in at Stage 2) ──
# Whatever model you name here needs a row in atomcv.llm.pricing, or every
# call it makes is costed at zero (F-015). The backend warns at startup when
# it does not.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# The second link, and a different vendor rather than a second
# model at the first: OpenRouter is itself a broker, so anything behind it
# shares the broker's outage. Empty means this provider is skipped in silence,
# which is the ordinary state of a deployment with one key.
GEMINI_API_KEY=
GEMINI_MODEL=
# The remaining three. Adapters exist for all of them; none is in
# either default chain and none does anything without both a key and a model.
# Reach for one when you want a link that does NOT share OpenRouter's fate --
# a model served through the broker goes dark when the broker does.
#
# Each one you configure is a sub-processor, and the provider list has to
# name it before it sees a CV.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Comma-separated, front to back. Naming an adapter that does not exist logs a
# warning and is skipped; an order with nothing runnable in it fails every
# generation. DeepSeek belongs behind a schema-enforcing link rather than in
# front of one: it only promises valid JSON, so the shape is
# asked for in words and a wrong shape is retried.
LLM_CHAIN_CHEAP=
LLM_CHAIN_MID=

# ── Identity (filled in at Stage 3) ──
# No SESSION_SECRET: a session id is 256 random bits kept in Redis and nothing
# is signed, so there is nothing for a secret to sign. An unused secret is
# only a secret to leak.
#
# GitHub OAuth Apps accept a single callback URL, so development and
# production are two separate apps with two separate pairs here.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# The secret half of the Turnstile pair; the site key is the frontend's and is
# public by design. Empty locally, where the app warns and waves sign-in
# requests through. Under the `prod` profile it is required and start-up fails
# without it -- a deployment with no challenge works perfectly and is open, so
# nobody would ever find out from the behaviour.
TURNSTILE_SECRET_KEY=

# Empty outside production, and never with a leading dot: `.mustafatetik.com`
# would send the session cookie to the portfolio site on the same apex.
# Start-up refuses the dotted form rather than trusting this comment.
SESSION_COOKIE_DOMAIN=
# Off only for local http, where Safari refuses a Secure cookie.
SESSION_COOKIE_SECURE=true

# ── Rate limiting ──
# `framework` behind a reverse proxy, `none` when anything can reach the port
# directly. It decides who the caller is, so it decides which bucket they land
# in: left unset behind Nginx every caller arrives as the proxy and the
# per-IP layer becomes one bucket the whole deployment shares — a limiter that
# looks configured and locks everybody out on the tenth sign-in request. Set
# to `framework` in production; `none` is a header a client can forge.
FORWARD_HEADERS_STRATEGY=none
# The defaults are the three numbers: 3 per address / 15m, 10 per IP
# / 1h, 200 across the deployment / 1h. Only the last one usually needs
# moving, and it moves with the sending provider's tolerance.
RATE_LIMIT_SIGN_IN_GLOBAL=200

# ── Services (filled in at Stage 3) ──
RESEND_API_KEY=
# The webhook endpoint secret, from Resend -> Webhooks -> your endpoint. A hard
# bounce or a complaint arrives there and stops us writing to that address
# again. Empty refuses every delivery rather than trusting one -- a
# believed forgery suppresses somebody's address and locks them out.
RESEND_WEBHOOK_SECRET=
# The From address has to live under the subdomain verified for sending: SPF
# and DKIM are published there and nowhere else, so a From on the apex fails
# both and the mail lands in spam.
EMAIL_FROM=no-reply@mail.atomcv.mustafatetik.com
EMAIL_FROM_NAME=AtomCV
EMAIL_REPLY_TO=
# Sentry -> Settings -> Projects -> <project> -> Client Keys (DSN). Empty
# outside production, where the SDK is a no-op: a stack trace from a laptop is
# noise in a dashboard that exists to show what users hit.
SENTRY_DSN=

# Without a Resend key the backend sends over SMTP instead, which locally
# means Mailpit at localhost:1025 (its inbox is at http://localhost:8025).
# With neither, it warns at startup and sign-in links go nowhere.

# Optional, and only about a rate limit. The GitHub import reads
# public data and works without it; unauthenticated GitHub allows sixty
# requests an hour per address, which this whole deployment shares, and a token
# raises that to five thousand. A fine-grained token with read-only public
# access and no scopes is the right one -- nothing here asks for a permission.
GITHUB_API_TOKEN=

# ── Analytics (optional) ──
# Umami, self-hosted beside the application and served at /analytics.
# Cookieless, which is why this product needs no consent banner at all
# -- switching to anything that sets one would change the legal
# text as well as the compose file.
#
# The service only starts when it is asked for:
#   docker compose --profile analytics -f docker-compose.prod.yml up -d
#
# Read by compose and by nothing in the application. Any long random string;
# rotating it signs every dashboard session out and nothing else.
UMAMI_APP_SECRET=

# ── Observability ──
# OTLP and not AXIOM_*: the name is the wire format's, not the vendor's, so
# leaving Axiom would not turn these into lies. Two traps: the Authorization
# value carries its own `Bearer ` prefix, and micrometer-registry-otlp exports
# *metrics*, so the URL is the provider's metrics endpoint — a metric sent to
# a trace endpoint is refused without a line in the log.
OTLP_ENABLED=false
OTLP_URL=
OTLP_AUTHORIZATION=
OTLP_DATASET=
DEPLOY_ENV=local

# ── Budget ──
# The kill switch, read as atomcv.anomaly.daily-budget-usd. The
# name used to be DAILY_BUDGET_USD here and in four places in the spec while
# the code read this one, so setting a limit set nothing (EnvExampleTest).
ANOMALY_DAILY_BUDGET_USD=40

# ── Backup ──
# Read by scripts/backup.sh and scripts/archive-wal.sh, never by the
# application. Both refuse to run without the age key rather than shipping a
# plaintext dump: the dump is every CV in the product, and an object-store
# credential is not a reason to trust the object store with it.
#
# PUBLIC half only. The private half must NOT be on this server -- whoever
# takes the server would otherwise have both halves and the encryption would
# be decoration. Keep it where you would keep a recovery code.
AGE_PUBLIC_KEY=

# The two providers. The daily copy and the WAL archive go to the
# first; the weekly and monthly copies go to the second, because an account
# suspension or a console mistake takes every copy on one provider at once.
# With no second remote configured, backup.sh still runs and says so in its
# log -- one provider is a backup, it is just not 3-2-1.
BACKUP_REMOTE=r2:atomcv-backups
BACKUP_ARCHIVE_REMOTE=b2:atomcv-archive

# The retention, and the three numbers the privacy text is
# written against: an anonymous profile caught in a backup can live at most
# six months. Raising the last one changes what that page has to promise.
BACKUP_KEEP_DAILY=7d
BACKUP_KEEP_WEEKLY=28d
BACKUP_KEEP_MONTHLY=180d
